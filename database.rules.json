{
  "rules": {
    "vocab": {
      ".read": true,
      ".indexOn": ["id", "e", "k", "s", "t"],
      "$itemId": {
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "dictionary": {
      ".read": true,
      ".indexOn": ["s", "t"],
      "$itemId": {
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "stories": {
      ".read": true,
      ".indexOn": ["lang", "ts"],
      "$storyId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['storyText', 'questions', 'lang', 'ts']) && newData.child('lang').isString() && newData.child('storyText').isString()"
      }
    },
    "grammar_exercises": {
      ".read": true,
      "$vocabId": {
        "$lang": {
          "$token": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['grammar', 'usage', 'example', 'exercises', 'model', 'ts'])"
          }
        }
      }
    }
  }
}