{
  "rules": {
    "vocab": {
      ".read": true,
      ".indexOn": ["id", "e", "k", "s", "t"],
      "$itemId": {
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "dictionary": {
      ".read": true,
      ".indexOn": ["s", "t"],
      "$itemId": {
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
"stories": {
      ".read": true,
      "$vocabKey": {
        "$lang": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['story', 'questions', 'vocabIds', 'ts']) && newData.child('story').isString()"
        }
      }
    },
    "grammar_exercises": {
      ".read": true,
      "$vocabId": {
        "$lang": {
          "$explainLang": {
            "$token": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['grammar', 'usage', 'example', 'exercises', 'model', 'ts'])"
            }
          }
        }
      }
    }
  }
}